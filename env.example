# === GitHub Secrets you must set ===
# Render API access
RENDER_API_KEY=
# JSON map of app->service_id for staging, production (paste into repository secret RENDER_SERVICES_JSON)
# Example format placed in infra/render.services.json as well for reference.
RENDER_SERVICES_JSON={"staging":{"homecouver":"srv-xxxxxxxx","startbaz":"srv-yyyyyyyy"},"production":{"homecouver":"srv-aaaaaaaa","startbaz":"srv-bbbbbbbb"}}

# For release workflow (optional; only if you want automated GitHub Releases on tags)
GH_TOKEN=
